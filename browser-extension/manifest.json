{
  "manifest_version": 3,
  "name": "GLaDOS Check-in Cookie Helper",
  "version": "1.0.1",
  "description": "Read the current GLaDOS session into the GLaDOS Check-in Console.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GLaDOS Cookie Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://glados-facility.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
